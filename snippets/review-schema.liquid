{%- comment -%}
  Review / AggregateRating JSON-LD Schema for Shopify
  Include in product template alongside Product schema
  Requires metafields: product.metafields.reviews.aggregate_rating (JSON: {value, count})
  and product.metafields.reviews.individual (array of review objects)
{%- endcomment -%}

{%- if product.metafields.reviews.aggregate_rating -%}
{%- assign rating = product.metafields.reviews.aggregate_rating -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating.value | json }},
    "reviewCount": {{ rating.count | json }},
    "bestRating": "5",
    "worstRating": "1"
  }{%- if product.metafields.reviews.individual -%}
  ,
  "review": [
    {%- for review in product.metafields.reviews.individual -%}
      {
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": {{ review.author | default: 'Verified Buyer' | json }}
        },
        "datePublished": {{ review.date | date: '%Y-%m-%d' | json }},
        "reviewBody": {{ review.body | strip_html | json }},
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": {{ review.rating | json }},
          "bestRating": "5",
          "worstRating": "1"
        }{%- if review.title -%}
        ,
        "name": {{ review.title | json }}
        {%- endif -%}
      }{%- unless forloop.last %},{% endunless -%}
    {%- endfor -%}
  ]
  {%- endif -%}
}
</script>
{%- endif -%}