{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>

{%- liquid
  if request.page_type == 'article' and article != blank and article.blog.handle == 'knowledge-base'
    assign canonical_url = canonical_url | replace: '/blogs/knowledge-base/', '/blogs/guides/'
  endif
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
  <meta
    property="og:image:alt"
    content="{{ page_title | default: shop.name | escape }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ shop.currency }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- if page_image -%}
  <meta
    name="twitter:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    name="twitter:image:alt"
    content="{{ page_title | default: shop.name | escape }}"
  >
{%- endif -%}

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- liquid
  assign meta_description = page_description
  if meta_description == blank and request.page_type == 'product' and product != blank
    assign meta_description = product.description | strip_html | truncatewords: 25
  endif
  if meta_description == blank and request.page_type == 'article' and article != blank
    assign meta_description = article.excerpt_or_content | strip_html | truncatewords: 25
  endif
  if meta_description == blank and request.page_type == 'collection' and collection != blank
    assign meta_description = collection.description | strip_html | truncatewords: 25
    if meta_description == blank
      assign meta_description = 'Body-safe premium products at BBCxMaster. Discreet shipping, expert guides, 30-day returns.'
    endif
  endif
  if request.page_type == 'collection' and collection != blank
    if page_title == blank or page_title == collection.title
       assign seo_collection_title = collection.title | append: ' – ' | append: shop.name
      if seo_collection_title != page_title
        assign page_title = seo_collection_title
      endif
    endif
  endif
  if meta_description == blank and request.page_type == 'page' and page != blank
    assign meta_description = page.content | strip_html | truncatewords: 25
  endif
  if meta_description == blank
    assign meta_description = shop.description
  endif
-%}
{% if meta_description != blank %}
  <meta
    name="description"
    content="{{ meta_description | escape }}"
  >
{% endif %}

<!-- SEO & Accessibility -->
{%- liquid
  assign is_thin_page = false
  assign merchant_noindex = false
  if request.page_type == 'product' and product.tags contains 'seo-noindex'
    assign merchant_noindex = true
  endif
  if request.page_type == 'search' or request.page_type == 'cart' or request.page_type == 'list-collections' or request.page_type == '404'
    assign is_thin_page = true
  endif
-%}
{%- comment -%}
  Robots directives:
  - Thin/utility pages (search, cart, list-collections, 404): noindex, follow
  - Paginated pages (page 2+): noindex, follow — prevents thin duplicate-content
    pages from being indexed while preserving link equity flow
  - All other pages: index, follow with max previews for rich results
{%- endcomment -%}
{%- if is_thin_page or merchant_noindex -%}
  <meta name="robots" content="noindex, follow">
  <meta name="googlebot" content="noindex, follow">
  <meta name="bingbot" content="noindex, follow">
{%- elsif current_page > 1 -%}
  <meta name="robots" content="noindex, follow">
  <meta name="googlebot" content="noindex, follow">
  <meta name="bingbot" content="noindex, follow">
{%- else -%}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{%- endif -%}
<meta name="language" content="{{ request.locale.iso_code }}">
<meta name="author" content="{{ shop.name | escape }}">
{% if request.page_type != 'product' %}<link rel="alternate" href="{{ shop.url }}/sitemap.xml" type="application/xml">{% endif %}
{% if request.page_type == 'article' and article.published_at %}<meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' }}" data-testid="article-published-time">{% endif %}
{% if request.page_type == 'article' %}
  {% assign article_modified_at = article.updated_at | default: article.published_at %}
  {% if article_modified_at %}<meta property="article:modified_time" content="{{ article_modified_at | date: '%Y-%m-%dT%H:%M:%S%:z' }}" data-testid="article-modified-time">{% endif %}
{% endif %}

<!-- Additional SEO Enhancements -->
<meta name="theme-color" content="#9E2F45">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
{% if page_title %}<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">{% endif %}

<!-- hreflang for multi-language support -->
{%- if localization.available_languages.size > 1 -%}
  {%- for language in localization.available_languages -%}
    <link rel="alternate" hreflang="{{ language.iso_code }}" href="{{ request.origin }}/{{ language.iso_code }}{{ request.path }}">
  {%- endfor -%}
  <link rel="alternate" hreflang="x-default" href="{{ request.origin }}{{ request.path }}">
{%- endif -%}
