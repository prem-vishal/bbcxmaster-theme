{% comment %}
  BBCxMaster - FAQ Page Section
  Dark BDSM-Luxury visual identity with full copy readability & structured FAQPage JSON-LD schema
{% endcomment %}

{{ 'luxury-theme.css' | asset_url | stylesheet_tag }}

{%- capture seo_title -%}
  Frequently Asked Questions | BBCxMaster
{%- endcapture -%}

{%- capture seo_description -%}
  Find answers to common questions about discreet shipping, billing, materials, sizing, and order policies at BBCxMaster.
{%- endcapture -%}

<head>
  <title>{{ seo_title | strip }}</title>
  <meta name="description" content="{{ seo_description | strip }}">
  <link rel="canonical" href="{{ shop.url }}/pages/frequently-asked-questions">
  <meta property="og:title" content="{{ seo_title | strip }}">
  <meta property="og:description" content="{{ seo_description | strip }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ shop.url }}/pages/frequently-asked-questions">
</head>

<article class="faq-page luxury-page-container">

  <!-- Hero Section -->
  <header class="faq-hero">
    <div class="faq-hero__bg-wrapper">
      <img
        src="{{ 'hero_submissive_premium.jpg' | asset_url }}"
        alt="BBCxMaster Client Support & Guidance - Frequently Asked Questions"
        class="faq-hero__image"
        loading="eager"
        width="1920"
        height="1080"
      >
      <div class="faq-hero__overlay"></div>
    </div>

    <div class="faq-hero__content">
      <nav class="luxury-breadcrumbs" aria-label="Breadcrumb navigation">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item"><a href="{{ shop.url }}">Home</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li class="breadcrumb-item active" aria-current="page">FAQ</li>
        </ol>
      </nav>

      <span class="faq-hero__badge">{{ section.settings.kicker | default: 'Support & Guidance' }}</span>
      <h1 class="faq-hero__title">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h1>
      <p class="faq-hero__subtitle">Find complete clarity on our discreet packaging, secure billing, body-safe materials, and shipping policies.</p>

      <div class="faq-meta-badge">
        <span class="faq-meta-icon">💡</span>
        <span>Client Support Concierge | <strong>Bank-Grade Discretion Assured</strong></span>
      </div>
    </div>
  </header>

  <!-- Sticky Navigation Sub-Header -->
  <nav class="faq-subnav" aria-label="FAQ Navigation">
    <div class="faq-subnav__inner">
      <a href="#shipping" class="subnav-link">Discreet Shipping</a>
      <a href="#billing" class="subnav-link">Secure Billing</a>
      <a href="#materials" class="subnav-link">Materials & Quality</a>
      <a href="#returns" class="subnav-link">Returns & Policy</a>
      <a href="#contact" class="subnav-link">Client Concierge</a>
    </div>
  </nav>

  <div class="faq-main-wrapper">
    <!-- Desktop Table of Contents Sidebar -->
    <aside class="faq-toc-sidebar" aria-label="Table of Contents">
      <div class="toc-sticky-box">
        <h2 class="toc-title">Support Categories</h2>
        <ul class="toc-list">
          <li><a href="#shipping">1. Discreet Shipping & Packaging</a></li>
          <li><a href="#billing">2. Billing & Payment Discretion</a></li>
          <li><a href="#materials">3. Materials & Body Safety</a></li>
          <li><a href="#returns">4. Returns & Exchanges</a></li>
          <li><a href="#contact">5. Client Concierge Support</a></li>
        </ul>

        <div class="toc-trust-card">
          <div class="trust-card-header">
            <span class="trust-icon">🛡️</span>
            <strong>Absolute Discretion</strong>
          </div>
          <p>Every shipment is packaged without brand logos, product descriptions, or external hints. Your privacy is guaranteed.</p>
        </div>
      </div>
    </aside>

    <!-- Main FAQ Content Body -->
    <main class="faq-content-body">

      <!-- Section 1: Shipping -->
      <section id="shipping" class="policy-section">
        <h2 class="section-title">1. Discreet Shipping & Packaging</h2>
        <div class="policy-card">
          <div class="faq-accordion-group">
            <details class="faq-item" open>
              <summary class="faq-question">
                <span>How will my package arrive?</span>
                <span class="faq-chevron">+</span>
              </summary>
              <div class="faq-answer">
                <p>All BBCxMaster orders are shipped in 100% plain, unbranded boxes or opaque poly-mailers. There are zero product titles, brand logos, or sensitive words printed anywhere on the exterior packaging.</p>
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">
                <span>What name appears on the return address?</span>
                <span class="faq-chevron">+</span>
              </summary>
              <div class="faq-answer">
                <p>To maintain absolute discretion, shipments originate under a neutral corporate fulfillment name. No mention of adult novelties or explicit branding is ever displayed on parcel labels.</p>
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">
                <span>How long does shipping take?</span>
                <span class="faq-chevron">+</span>
              </summary>
              <div class="faq-answer">
                <p>Order processing takes 1 to 2 business days. Domestic standard delivery takes 3–5 business days, while express priority shipping takes 1–3 business days. Tracking links are emailed automatically upon dispatch.</p>
              </div>
            </details>
          </div>
        </div>
      </section>

      <!-- Section 2: Billing -->
      <section id="billing" class="policy-section">
        <h2 class="section-title">2. Billing & Payment Discretion</h2>
        <div class="policy-card">
          <div class="faq-accordion-group">
            <details class="faq-item" open>
              <summary class="faq-question">
                <span>What will show on my credit card statement?</span>
                <span class="faq-chevron">+</span>
              </summary>
              <div class="faq-answer">
                <p>Your bank or credit card statement will reflect a discreet, neutral corporate billing descriptor. Explicit product titles or adult terminology are never displayed on financial statements.</p>
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">
                <span>Is my payment data secure?</span>
                <span class="faq-chevron">+</span>
              </summary>
              <div class="faq-answer">
                <p>Yes. All checkout transmissions utilize bank-grade SSL/TLS encryption. We do not store raw credit card numbers on our local servers.</p>
              </div>
            </details>
          </div>
        </div>
      </section>

      <!-- Section 3: Materials -->
      <section id="materials" class="policy-section">
        <h2 class="section-title">3. Materials & Body Safety</h2>
        <div class="policy-card">
          <div class="faq-accordion-group">
            <details class="faq-item" open>
              <summary class="faq-question">
                <span>What materials are used in BBCxMaster products?</span>
                <span class="faq-chevron">+</span>
              </summary>
              <div class="faq-answer">
                <p>We prioritize premium, body-safe materials: 100% medical-grade silicone, non-porous stainless steel, lead-free metals, and genuine/vegan leather. All products are 100% free from phthalates, BPA, and toxic softeners.</p>
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">
                <span>Which lubricant should I use?</span>
                <span class="faq-chevron">+</span>
              </summary>
              <div class="faq-answer">
                <p>Always pair silicone accessories with high-grade water-based lubricants. Avoid silicone lube on silicone toys to prevent surface degradation.</p>
              </div>
            </details>
          </div>
        </div>
      </section>

      <!-- Section 4: Returns -->
      <section id="returns" class="policy-section">
        <h2 class="section-title">4. Returns & Exchanges</h2>
        <div class="policy-card">
          <div class="faq-accordion-group">
            <details class="faq-item" open>
              <summary class="faq-question">
                <span>What is your return policy?</span>
                <span class="faq-chevron">+</span>
              </summary>
              <div class="faq-answer">
                <p>For strict hygiene and safety reasons, opened or used intimate items cannot be returned. Unopened, unused items in original packaging may be returned within 30 days of delivery.</p>
              </div>
            </details>
          </div>
        </div>
      </section>

      <!-- Section 5: Contact -->
      <section id="contact" class="policy-section">
        <h2 class="section-title">5. Client Concierge Support</h2>
        <div class="policy-card faq-contact-card">
          <p>If your specific question is not addressed above, our expert support team is ready to assist you with absolute confidentiality:</p>
          <div class="faq-contact-details">
            <p><strong>BBCxMaster Client Concierge</strong></p>
            <p>Email: <a href="mailto:support@bbcxmaster.com" class="faq-link">support@bbcxmaster.com</a></p>
            <p>Support Portal: <a href="/pages/contact" class="faq-link">Contact Form</a></p>
          </div>
        </div>
      </section>

      <!-- Dynamic Blocks Support -->
      {% content_for 'blocks' %}

    </main>
  </div>
</article>

<!-- JSON-LD Structured Data for FAQPage -->
{% capture faq_json_ld %}
  {% for accordion_block in section.blocks %}
    {% if accordion_block.type == 'accordion' %}
      {% for row in accordion_block.blocks %}
        {% liquid
          assign question = row.settings.heading | strip_html | strip
          assign answer = ''
          for answer_block in row.blocks
            assign answer = answer | append: answer_block.settings.text
          endfor
          assign answer = answer | strip_html | strip
        %}
        {% if question != blank and answer != blank %}
          {% unless forloop.first %},{% endunless %}
          {
            "@type": "Question",
            "name": {{ question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ answer | json }}
            }
          }
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
{% endcapture %}

{% assign faq_json_ld = faq_json_ld | strip %}
{% if faq_json_ld != blank %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{{ faq_json_ld }}]
    }
  </script>
{% else %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How will my package arrive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All BBCxMaster orders are shipped in 100% plain, unbranded boxes or opaque poly-mailers with zero product titles or brand logos."
          }
        },
        {
          "@type": "Question",
          "name": "What will show on my credit card statement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your bank or credit card statement will reflect a discreet corporate billing descriptor without explicit product titles."
          }
        },
        {
          "@type": "Question",
          "name": "What materials are used in BBCxMaster products?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We prioritize 100% medical-grade silicone, non-porous stainless steel, lead-free metals, and genuine/vegan leather, free from phthalates."
          }
        }
      ]
    }
  </script>
{% endif %}

<style>
/* CSS Styles for FAQ Dark Luxury Editorial Theme */
.faq-page {
  background-color: var(--color-luxury-bg-dark, #0a0a0a);
  color: var(--color-luxury-text-primary, #e5e5e5);
  font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
  padding-bottom: 80px;
  max-width: 100%;
}

.faq-hero {
  position: relative;
  min-height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  background: linear-gradient(135deg, #111111 0%, #0a0a0a 100%);
  border-bottom: 1px solid var(--color-luxury-border, rgba(158, 47, 69, 0.3));
}

.faq-hero__bg-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.faq-hero__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.faq-hero__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at center, rgba(158, 47, 69, 0.06) 0%, rgba(10, 10, 10, 0.95) 80%);
}

.faq-hero__content {
  position: relative;
  z-index: 2;
  max-width: 800px;
  padding: 60px 20px;
}

.faq-hero__badge {
  display: inline-block;
  font-size: 0.75rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--color-luxury-accent, #9E2F45);
  background: rgba(158, 47, 69, 0.1);
  border: 1px solid rgba(158, 47, 69, 0.3);
  padding: 6px 16px;
  border-radius: 20px;
  margin-bottom: 20px;
}

.faq-hero__title {
  font-family: var(--font-heading-family, "Cinzel", "Playfair Display", serif);
  font-size: clamp(2.2rem, 5vw, 3.5rem);
  color: #ffffff;
  margin: 0 0 15px 0;
  letter-spacing: 1px;
}

.faq-hero__subtitle {
  font-size: 1.15rem;
  color: var(--color-luxury-text-secondary, #b3b3b3);
  margin-bottom: 25px;
  line-height: 1.6;
}

.faq-meta-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 0.85rem;
  color: var(--color-luxury-accent, #9E2F45);
  background: rgba(10, 10, 10, 0.7);
  border: 1px solid rgba(158, 47, 69, 0.3);
  padding: 8px 18px;
  border-radius: 4px;
}

/* Sticky Subnav */
.faq-subnav {
  position: sticky;
  top: 0;
  z-index: 90;
  background: rgba(15, 15, 15, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--color-luxury-border, rgba(255, 255, 255, 0.1));
}

.faq-subnav__inner {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  padding: 14px 20px;
  max-width: 1280px;
  margin: 0 auto;
  scrollbar-width: none;
}

.faq-subnav__inner::-webkit-scrollbar {
  display: none;
}

.subnav-link {
  color: var(--color-luxury-text-secondary, #a0a0a0);
  text-decoration: none;
  font-size: 0.85rem;
  white-space: nowrap;
  letter-spacing: 0.5px;
  transition: color 0.2s ease;
}

.subnav-link:hover {
  color: var(--color-luxury-accent, #9E2F45);
}

/* Layout Wrapper */
.faq-main-wrapper {
  max-width: 1280px;
  margin: 40px auto 0;
  padding: 0 20px;
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 40px;
}

/* Sidebar Index */
.toc-sticky-box {
  position: sticky;
  top: 70px;
  background: #121212;
  border: 1px solid var(--color-luxury-border, rgba(255, 255, 255, 0.08));
  border-radius: 8px;
  padding: 24px;
}

.toc-title {
  font-family: var(--font-heading-family, serif);
  font-size: 1.1rem;
  color: #ffffff;
  margin-top: 0;
  margin-bottom: 16px;
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.toc-list {
  list-style: none;
  padding: 0;
  margin: 0 0 24px 0;
}

.toc-list li {
  margin-bottom: 10px;
}

.toc-list a {
  color: var(--color-luxury-text-secondary, #a0a0a0);
  text-decoration: none;
  font-size: 0.88rem;
  line-height: 1.4;
  transition: color 0.2s ease;
}

.toc-list a:hover {
  color: var(--color-luxury-accent, #9E2F45);
}

.toc-trust-card {
  background: rgba(158, 47, 69, 0.08);
  border: 1px solid rgba(158, 47, 69, 0.25);
  padding: 16px;
  border-radius: 6px;
  font-size: 0.82rem;
  line-height: 1.5;
  color: var(--color-luxury-text-secondary, #b3b3b3);
}

.trust-card-header {
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

/* Content Body */
.policy-section {
  margin-bottom: 35px;
  scroll-margin-top: 80px;
}

.section-title {
  font-family: var(--font-heading-family, serif);
  font-size: 1.5rem;
  color: #ffffff;
  margin-bottom: 16px;
  letter-spacing: 0.5px;
  border-bottom: 1px solid rgba(158, 47, 69, 0.2);
  padding-bottom: 8px;
}

.policy-card {
  background: #141414;
  border: 1px solid var(--color-luxury-border, rgba(255, 255, 255, 0.08));
  border-radius: 8px;
  padding: 24px 30px;
  line-height: 1.7;
  color: #d1d1d1;
  font-size: 0.98rem;
}

/* Accordion Styles */
.faq-accordion-group {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.faq-item {
  background: #1a1a1a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 6px;
  overflow: hidden;
  transition: border-color 0.2s ease;
}

.faq-item[open] {
  border-color: rgba(158, 47, 69, 0.4);
}

.faq-question {
  padding: 16px 20px;
  font-size: 1.05rem;
  font-weight: 500;
  color: #ffffff;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.faq-question::-webkit-details-marker {
  display: none;
}

.faq-chevron {
  color: var(--color-luxury-accent, #9E2F45);
  font-size: 1.2rem;
  transition: transform 0.3s ease;
}

.faq-item[open] .faq-chevron {
  transform: rotate(45deg);
}

.faq-answer {
  padding: 0 20px 18px 20px;
  color: var(--color-luxury-text-secondary, #b3b3b3);
  font-size: 0.95rem;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  padding-top: 14px;
}

.faq-answer p {
  margin: 0;
}

.faq-link {
  color: var(--color-luxury-accent, #9E2F45);
  text-decoration: underline;
}

.faq-link:hover {
  color: #ffffff;
}

.faq-contact-card {
  border-left: 3px solid var(--color-luxury-accent, #9E2F45);
}

.faq-contact-details {
  margin-top: 15px;
  padding: 15px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 6px;
}

/* Responsive Rules */
@media (max-width: 992px) {
  .faq-main-wrapper {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .faq-toc-sidebar {
    display: none;
  }
}

@media (max-width: 768px) {
  .faq-hero {
    min-height: 340px;
  }

  .faq-hero__content {
    padding: 52px 16px 42px;
  }

  .faq-subnav__inner {
    gap: 12px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .faq-main-wrapper {
    margin-top: 24px;
    padding: 0 16px;
  }

  .policy-card {
    padding: 20px 18px;
  }

  .faq-question {
    gap: 12px;
    align-items: flex-start;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .faq-answer {
    padding-left: 16px;
    padding-right: 16px;
  }

  .section-title {
    font-size: 1.3rem;
  }
}

@media (max-width: 480px) {
  .faq-hero__badge {
    font-size: 0.68rem;
    letter-spacing: 1.2px;
    padding: 6px 12px;
  }

  .faq-hero__title {
    line-height: 1.1;
    letter-spacing: 0.5px;
  }

  .faq-meta-badge {
    width: 100%;
    justify-content: center;
    text-align: left;
    white-space: normal;
  }

  .faq-question {
    padding: 14px 16px;
  }

  .faq-answer {
    padding-bottom: 14px;
  }
}

@media (max-width: 360px) {
  .faq-subnav__inner {
    gap: 8px;
  }

  .subnav-link {
    font-size: 0.78rem;
  }

  .faq-hero__subtitle {
    font-size: 1rem;
  }
}
</style>

{% schema %}
{
  "name": "FAQ",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "accordion"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Support & Guidance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
