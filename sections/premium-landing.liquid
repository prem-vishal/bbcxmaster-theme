{% comment %}
  Premium editorial hero for the BBCxMaster homepage.
  Split layout: Left = Text, Right = Auto-rotating BDSM slideshow (5s interval).
{% endcomment %}

{% liquid
  assign hero_image = section.settings.image
  assign hero_video = section.settings.video
%}

<section
  class="founder-hero"
  aria-label="Luxury editorial introduction"
>
  <div class="founder-hero__media" aria-hidden="true">
    {% if hero_video != blank %}
      {{
        hero_video
        | video_tag:
          poster: hero_image,
          autoplay: true,
          loop: true,
          controls: false,
          muted: true,
          class: 'founder-hero__media-el'
      }}
    {% elsif hero_image != blank %}
      {{
        hero_image
        | image_url: width: 2400
        | image_tag:
          width: hero_image.width,
          height: hero_image.height,
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          fetchpriority: 'high',
          class: 'founder-hero__media-el'
      }}
    {% else %}
      <div class="founder-hero__fallback"></div>
    {% endif %}
    <div class="founder-hero__scrim"></div>
  </div>

  <div class="founder-hero__container founder-hero__split">
    <div class="founder-hero__content">
      <h1 class="founder-hero__title">
        {{ section.settings.heading | default: 'POWER. CONTROL. PLEASURE.' }}
      </h1>

      <p class="founder-hero__subtitle">
        {{ section.settings.subtitle | default: 'Elevate your experience with luxury BDSM essentials.' }}
      </p>

      {% if section.settings.bio != blank %}
        <div class="founder-hero__bio">
          {{ section.settings.bio }}
        </div>
      {% endif %}

      <div class="founder-hero__actions">
        <a
          href="{{ section.settings.cta_link | default: '/collections/all' }}"
          class="button founder-hero__button"
        >
          {{ section.settings.cta_label | default: 'EXPLORE COLLECTION' }}
        </a>
      </div>
    </div>

    <div class="founder-hero__slideshow" id="heroSlideshow">
      {% for block in section.blocks %}
        <div class="founder-hero__slide {% if forloop.first %}founder-hero__slide--active{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.slide_image != blank %}
            <img
              src="{{ block.settings.slide_image | image_url: width: 800 }}"
              srcset="{{ block.settings.slide_image | image_url: width: 400 }} 400w, {{ block.settings.slide_image | image_url: width: 800 }} 800w, {{ block.settings.slide_image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 749px) 100vw, 480px"
              alt="{{ block.settings.slide_label | default: 'BDSM Lifestyle' }}"
              class="founder-hero__slide-img"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="800"
              height="1067"
            >
          {% else %}
            <div class="founder-hero__slide-placeholder">
              <span>{{ block.settings.slide_label | default: 'Image' }}</span>
            </div>
          {% endif %}
          <div class="founder-hero__slide-label">{{ block.settings.slide_label }}</div>
        </div>
      {% endfor %}

      {% if section.blocks.size == 0 %}
        <div class="founder-hero__slide founder-hero__slide--active">
          <img
            src="{{ 'hero_master_premium_800.jpg' | asset_url }}"
            srcset="{{ 'hero_master_premium_800.jpg' | asset_url }} 800w, {{ 'hero_master_premium.jpg' | asset_url }} 896w"
            sizes="(max-width: 749px) 100vw, 480px"
            alt="Premium BDSM fashion editorial, Master collection" class="founder-hero__slide-img" loading="eager" fetchpriority="high" width="800" height="1067">
          <div class="founder-hero__slide-label">MASTER</div>
        </div>
        <div class="founder-hero__slide">
          <img
            src="{{ 'hero_slave_premium_800.jpg' | asset_url }}"
            srcset="{{ 'hero_slave_premium_800.jpg' | asset_url }} 800w, {{ 'hero_slave_premium.jpg' | asset_url }} 896w"
            sizes="(max-width: 749px) 100vw, 480px"
            alt="Premium BDSM fashion editorial, Slave collection" class="founder-hero__slide-img" loading="lazy" width="800" height="1067">
          <div class="founder-hero__slide-label">SLAVE</div>
        </div>
        <div class="founder-hero__slide">
          <img
            src="{{ 'hero_submissive_premium_800.jpg' | asset_url }}"
            srcset="{{ 'hero_submissive_premium_800.jpg' | asset_url }} 800w, {{ 'hero_submissive_premium.jpg' | asset_url }} 896w"
            sizes="(max-width: 749px) 100vw, 480px"
            alt="Premium BDSM fashion editorial, Submissive collection" class="founder-hero__slide-img" loading="lazy" width="800" height="1067">
          <div class="founder-hero__slide-label">SUBMISSIVE</div>
        </div>
        <div class="founder-hero__slide">
          <img
            src="{{ 'hero_mistress_premium_800.jpg' | asset_url }}"
            srcset="{{ 'hero_mistress_premium_800.jpg' | asset_url }} 800w, {{ 'hero_mistress_premium.jpg' | asset_url }} 896w"
            sizes="(max-width: 749px) 100vw, 480px"
            alt="Premium BDSM fashion editorial, Mistress collection" class="founder-hero__slide-img" loading="lazy" width="800" height="1067">
          <div class="founder-hero__slide-label">MISTRESS</div>
        </div>
      {% endif %}
    </div>

    <div class="founder-hero__dots" id="heroDots" role="tablist" aria-label="Slideshow navigation">
      {% for block in section.blocks %}
        <button
          type="button"
          class="founder-hero__dot {% if forloop.first %}founder-hero__dot--active{% endif %}"
          aria-label="Go to slide {{ forloop.index }}"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {% endfor %}
      {% if section.blocks.size == 0 %}
        <button type="button" class="founder-hero__dot founder-hero__dot--active" aria-label="Go to slide 1" aria-current="true"></button>
        <button type="button" class="founder-hero__dot" aria-label="Go to slide 2" aria-current="false"></button>
        <button type="button" class="founder-hero__dot" aria-label="Go to slide 3" aria-current="false"></button>
        <button type="button" class="founder-hero__dot" aria-label="Go to slide 4" aria-current="false"></button>
      {% endif %}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var slideshow = document.getElementById('heroSlideshow');
      if (!slideshow) return;
      var slides = slideshow.querySelectorAll('.founder-hero__slide');
      if (slides.length <= 1) return;
      var dots = document.querySelectorAll('#heroDots .founder-hero__dot');
      var current = 0;
      var timer;

      function goTo(index) {
        slides[current].classList.remove('founder-hero__slide--active');
        if (dots[current]) {
          dots[current].classList.remove('founder-hero__dot--active');
          dots[current].setAttribute('aria-current', 'false');
        }
        current = (index + slides.length) % slides.length;
        slides[current].classList.add('founder-hero__slide--active');
        if (dots[current]) {
          dots[current].classList.add('founder-hero__dot--active');
          dots[current].setAttribute('aria-current', 'true');
        }
      }

      function next() {
        goTo(current + 1);
      }

      function start() {
        stop();
        timer = setInterval(next, 5000);
      }

      function stop() {
        if (timer) clearInterval(timer);
      }

      // Touch / swipe support
      var startX = null;
      slideshow.addEventListener('touchstart', function(e) {
        startX = e.changedTouches[0].screenX;
        stop();
      }, { passive: true });
      slideshow.addEventListener('touchend', function(e) {
        if (startX === null) return;
        var diff = e.changedTouches[0].screenX - startX;
        if (Math.abs(diff) > 40) {
          goTo(diff < 0 ? current + 1 : current - 1);
        }
        startX = null;
        start();
      }, { passive: true });
      slideshow.addEventListener('mouseenter', stop);
      slideshow.addEventListener('mouseleave', start);

      if (dots.length) {
        dots.forEach(function(dot, i) {
          dot.addEventListener('click', function() {
            goTo(i);
          });
        });
      }

      start();
    });
  </script>
</section>

{% stylesheet %}
  .founder-hero {
    position: relative;
    width: 100%;
    min-height: 750px;
    height: 80vh;
    max-height: 850px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: linear-gradient(135deg, #040404 0%, #101010 100%);
  }

  .founder-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(135deg, rgba(8, 8, 8, 0.92) 0%, rgba(8, 8, 8, 0.25) 100%);
  }

  .founder-hero__media-el,
  .founder-hero__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .founder-hero__fallback {
    background:
      radial-gradient(circle at 20% 20%, rgba(158, 47, 69, 0.24), transparent 28%),
      linear-gradient(135deg, #0a0a0a 0%, #1b1b1b 100%);
  }

  .founder-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.85) 0%, rgb(0 0 0 / 0.45) 50%, rgb(0 0 0 / 0.85) 100%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.6));
  }

  .founder-hero__container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 24px;
  }

  .founder-hero__content {
    max-width: 500px;
    margin: 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    flex-shrink: 0;
  }

  /* Split Layout */
  .founder-hero__split {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
  }

  /* Slideshow Container */
  .founder-hero__slideshow {
    position: relative;
    width: clamp(380px, 32vw, 520px);
    height: clamp(507px, 42.7vw, 693px);
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(158, 47, 69, 0.25);
    border: 1px solid color-mix(in srgb, var(--color-luxury-accent) 25%, transparent);
  }

  .founder-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .founder-hero__slide--active {
    opacity: 1;
  }

  .founder-hero__slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .founder-hero__slide-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .founder-hero__slide-placeholder span {
    font-family: var(--font-heading--family);
    font-size: 2rem;
    letter-spacing: 0.2em;
    color: rgba(158, 47, 69, 0.3);
    color: color-mix(in srgb, var(--color-luxury-accent) 30%, transparent);
    text-transform: uppercase;
  }

  .founder-hero__slide-label {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-body--family);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: #d9a0a8;
    color: color-mix(in srgb, var(--color-luxury-accent) 70%, #fff);
    text-transform: uppercase;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  .founder-hero__dots {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 8px;
    padding-bottom: 10px;
    z-index: 3;
  }

  .founder-hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(158, 47, 69, 0.6);
    border: 1px solid color-mix(in srgb, var(--color-luxury-accent) 60%, transparent);
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
    /* Expand touch target while keeping visual size */
    position: relative;
  }

  .founder-hero__dot::after {
    content: '';
    position: absolute;
    inset: -18px;
    border-radius: 50%;
  }

  .founder-hero__dot--active {
    background: var(--color-luxury-accent);
    border-color: var(--color-luxury-accent);
    transform: scale(1.25);
  }

  @media screen and (max-width: 992px) {
    .founder-hero {
      min-height: auto;
      height: auto;
      padding: 60px 0;
    }
    .founder-hero__split {
      flex-direction: column;
      gap: 30px;
    }
    .founder-hero__content {
      max-width: 100%;
      align-items: center;
      text-align: center;
    }
    .founder-hero__content .luxury-kicker {
      justify-content: center !important;
    }
    .founder-hero__content .luxury-kicker::before {
      display: none;
    }
    .founder-hero__content .founder-hero__subtitle {
      margin-left: auto !important;
      margin-right: auto !important;
    }
    .founder-hero__actions {
      justify-content: center !important;
      width: 100%;
    }
    .founder-hero__slideshow {
      width: 100%;
      aspect-ratio: 3 / 4;
      height: auto;
    }
    .founder-hero__title {
      font-size: clamp(1.8rem, 2rem + 1vw, 3rem);
    }
    .founder-hero__button {
      width: 100%;
      max-width: 280px;
    }
    .founder-hero__dots {
      gap: 12px;
      padding-bottom: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .founder-hero__slide {
      transition: none;
    }
    .founder-hero__slide--active {
      opacity: 1;
    }
  }

  .founder-hero__content .luxury-kicker {
    justify-content: flex-start;
  }

  .founder-hero__title {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2.5rem, 4rem + 1.4vw, 5.3rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #f8f3eb;
    margin: 0;
    max-width: 40rem;
  }

  .founder-hero__subtitle {
    font-family: var(--font-subheading--family);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    color: var(--color-luxury-accent);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0;
  }

  .founder-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.9rem;
    margin-top: 0.4rem;
  }

  .founder-hero__button {
    min-width: 12.5rem;
  }

  .founder-hero__highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    width: min(100%, 38rem);
    padding: 1rem;
    margin-top: 0.3rem;
  }

  .founder-hero__highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.9rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
  }

  .founder-hero__highlight strong {
    font-size: 1rem;
    color: #f8f3eb;
  }

  .founder-hero__highlight span {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(248, 243, 235, 0.77);
  }

  .founder-hero__bio {
    text-align: left;
    padding: 1.35rem 1.5rem;
    border-radius: 1.2rem;
    color: rgba(248, 243, 235, 0.92);
    font-size: 0.98rem;
    line-height: 1.7;
    max-width: 100%;
  }

  .founder-hero__bio p {
    margin: 0 0 0.9rem;
  }

  .founder-hero__bio p:last-child {
    margin-bottom: 0;
  }

  .founder-hero__bio ul {
    margin: 0 0 0.9rem;
    padding-inline-start: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }

  @media screen and (max-width: 749px) {
    .founder-hero__title {
      width: 100%;
      max-width: 100%;
      font-size: clamp(2rem, 9vw, 3rem);
      line-height: 1.02;
      letter-spacing: 0;
      overflow-wrap: anywhere;
    }

    .founder-hero__highlights {
      grid-template-columns: 1fr;
    }

    .founder-hero__bio {
      padding: 1.1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Founder Hero",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Luxury editorial commerce"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Modern essentials, sculpted with intention."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Signature pieces for a more elevated standard."
    },
    {
      "type": "richtext",
      "id": "bio",
      "label": "Bio",
      "default": "<p>Crafted for clients who value precision, longevity, and finish. Discover limited releases, concierge support, and a shopping experience designed to feel as refined as the pieces themselves.</p><ul><li>Quiet luxury materials and sculptural silhouettes</li><li>Limited editions and collector drops</li><li>Curated guidance from our style team</li></ul><p>Every detail is considered so the experience feels effortless from first glance to final delivery.</p>"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Defaults to the bundled brand image if left blank."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video (optional)",
      "info": "When set, plays instead of the image."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop the edit"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "slide_label",
          "label": "Slide Label",
          "default": "MASTER"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Founder Hero"
    }
  ]
}
{% endschema %}
