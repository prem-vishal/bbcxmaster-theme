{% comment %}
  BBCxMaster Knowledge Base & Customer Care Portal Section
{% endcomment %}

<div class="kb-portal-wrapper">
  <!-- HERO HEADER -->
  <section class="kb-hero">
    <div class="kb-hero__bg-wrapper">
      <img
        src="{{ 'hero_master_premium.jpg' | asset_url }}"
        alt="BBCxMaster Knowledge Base & Customer Care Portal"
        class="kb-hero__image"
        loading="eager"
        width="1920"
        height="1080"
      >
      <div class="kb-hero__overlay"></div>
    </div>
    <div class="kb-hero__container page-width">
      <span class="kb-hero__eyebrow">CUSTOMER CARE & KNOWLEDGE BASE</span>
      <h1 class="kb-hero__title">How can we help you?</h1>
      <p class="kb-hero__subtitle">Find detailed product guides, sizing charts, material safety information, and order policies.</p>
    </div>
  </section>

  <!-- QUICK CATEGORIES GRID -->
  <section class="kb-categories page-width">
    <h2 class="kb-section__heading">Browse by Product Category</h2>
    <div class="kb-categories__grid">
      <a href="/collections/vibrators" class="kb-category-card">
        <div class="kb-category-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        </div>
        <h3 class="kb-category-card__title">Luxury Vibrators</h3>
        <p class="kb-category-card__desc">Body-safe, rechargeable intimate massagers and wand advice.</p>
        <span class="kb-category-card__link">Explore Collection &rarr;</span>
      </a>

      <a href="/collections/premium-bondage-restraints" class="kb-category-card">
        <div class="kb-category-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </div>
        <h3 class="kb-category-card__title">Bondage & Restraints</h3>
        <p class="kb-category-card__desc">Ergonomic cuffs, leather restraints, harnesses, and safety tips.</p>
        <span class="kb-category-card__link">Explore Collection &rarr;</span>
      </a>

      <a href="/collections/lubricants" class="kb-category-card">
        <div class="kb-category-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
        </div>
        <h3 class="kb-category-card__title">Lubricants & Care</h3>
        <p class="kb-category-card__desc">Premium water-based & silicone formulas for seamless comfort.</p>
        <span class="kb-category-card__link">Explore Collection &rarr;</span>
      </a>

      <a href="/collections/chastity-cages" class="kb-category-card">
        <div class="kb-category-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <h3 class="kb-category-card__title">Chastity Cages</h3>
        <p class="kb-category-card__desc">Medical-grade stainless steel & silicone sizing and fitting guides.</p>
        <span class="kb-category-card__link">Explore Collection &rarr;</span>
      </a>
    </div>
  </section>

  <!-- FEATURED GUIDES GRID -->
  <section class="kb-articles page-width">
    <div class="kb-section__header">
      <div>
        <span class="kb-section__eyebrow">EXPERT GUIDES</span>
        <h2 class="kb-section__heading">Essential Buyer & Safety Guides</h2>
      </div>
      <a href="/blogs/guides" class="kb-section__all-link">View All Articles &rarr;</a>
    </div>

    <div class="kb-articles__grid">
      <article class="kb-article-card">
        <span class="kb-article-card__tag">Beginners</span>
        <h3 class="kb-article-card__title">How to Choose Your First Sex Toy</h3>
        <p class="kb-article-card__excerpt">A complete beginner guide covering materials, sizing, features, and safety for a confident purchase.</p>
        <a href="/blogs/guides/how-to-choose-your-first-sex-toy" class="kb-article-card__link">Read Guide &rarr;</a>
      </article>

      <article class="kb-article-card">
        <span class="kb-article-card__tag">Sizing Guide</span>
        <h3 class="kb-article-card__title">Chastity Cage Sizing & Fit Guide</h3>
        <p class="kb-article-card__excerpt">Accurately measure ring diameter and tube length for safe and comfortable long-term wear.</p>
        <a href="/blogs/guides/the-ultimate-chastity-cage-sizing-and-fit-guide" class="kb-article-card__link">Read Guide &rarr;</a>
      </article>

      <article class="kb-article-card">
        <span class="kb-article-card__tag">Body Safety</span>
        <h3 class="kb-article-card__title">Complete Guide to Body-Safe Lubricants</h3>
        <p class="kb-article-card__excerpt">Everything about personal lubricants: water-based vs silicone, ingredients, and toy compatibility.</p>
        <a href="/blogs/guides/the-complete-guide-to-body-safe-lubricants" class="kb-article-card__link">Read Guide &rarr;</a>
      </article>

      <article class="kb-article-card">
        <span class="kb-article-card__tag">Safety Standards</span>
        <h3 class="kb-article-card__title">Bondage Safety Checklist</h3>
        <p class="kb-article-card__excerpt">Essential pre-session guide covering safewords, circulation checks, emergency shears, and aftercare.</p>
        <a href="/blogs/guides/bondage-safety-checklist-the-complete-pre-session-guide" class="kb-article-card__link">Read Guide &rarr;</a>
      </article>

      <article class="kb-article-card">
        <span class="kb-article-card__tag">Exploration</span>
        <h3 class="kb-article-card__title">Beginner's Guide to Nipple Play</h3>
        <p class="kb-article-card__excerpt">Explore adjustable screw clamps, suction cups, sensation techniques, and safety boundaries.</p>
        <a href="/blogs/guides/beginner-guide-to-nipple-play-clamps-suckers-and-sensation" class="kb-article-card__link">Read Guide &rarr;</a>
      </article>

      <article class="kb-article-card">
        <span class="kb-article-card__tag">Care & Maintenance</span>
        <h3 class="kb-article-card__title">How to Maintain BDSM Leather Gear</h3>
        <p class="kb-article-card__excerpt">Sanitize, condition, and store genuine leather bondage restraints and body harnesses.</p>
        <a href="/blogs/guides/how-to-clean-store-and-maintain-bdsm-leather-gear" class="kb-article-card__link">Read Guide &rarr;</a>
      </article>
    </div>
  </section>

  <!-- FREQUENTLY ASKED QUESTIONS PORTAL -->
  <section class="kb-faq page-width">
    <h2 class="kb-section__heading">Frequently Asked Questions</h2>
    
    <div class="kb-faq__grid">
      <div class="kb-faq__group">
        <h3 class="kb-faq__group-title">Discreet Shipping & Billing</h3>
        
        <details class="kb-faq__item">
          <summary class="kb-faq__question">
            <span>How will my package arrive?</span>
            <svg class="kb-faq__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="kb-faq__answer">
            <p>All BBCxMaster orders are shipped in plain, unbranded boxes or mailers. There are no product descriptions, logos, or sensitive words printed on the outer packaging.</p>
          </div>
        </details>

        <details class="kb-faq__item">
          <summary class="kb-faq__question">
            <span>What will show on my credit card statement?</span>
            <svg class="kb-faq__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="kb-faq__answer">
            <p>Your billing statement will show a discreet corporate descriptor. Explicit product details or adult titles are never listed on billing records.</p>
          </div>
        </details>
      </div>

      <div class="kb-faq__group">
        <h3 class="kb-faq__group-title">Materials & Quality Standards</h3>

        <details class="kb-faq__item">
          <summary class="kb-faq__question">
            <span>What materials are used in BBCxMaster products?</span>
            <svg class="kb-faq__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="kb-faq__answer">
            <p>We prioritize body-safe materials: 100% medical-grade silicone, non-porous stainless steel, lead-free metals, and genuine/vegan leather. All products are free from phthalates, BPA, and toxic softeners.</p>
          </div>
        </details>

        <details class="kb-faq__item">
          <summary class="kb-faq__question">
            <span>Which lubricant should I use with my accessories?</span>
            <svg class="kb-faq__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="kb-faq__answer">
            <p>Always pair silicone accessories with high-grade <strong>water-based lubricants</strong> (explore our <a href="/collections/lubricants" style="color: #b89759; text-decoration: underline;">Lubricants Collection</a>). Avoid silicone lube on silicone toys to prevent surface degradation.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA FOOTER BLOCK -->
  <section class="kb-cta page-width">
    <div class="kb-cta__card">
      <h3 class="kb-cta__title">Still need assistance?</h3>
      <p class="kb-cta__text">Our concierge customer support team is ready to answer any questions regarding product specifications or order status.</p>
      <div class="kb-cta__actions">
        <a href="/pages/contact" class="button button--primary">Contact Support</a>
        <a href="/blogs/guides" class="button button--secondary">Visit Guides Hub</a>
      </div>
    </div>
  </section>
</div>

