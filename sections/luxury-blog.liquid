{% stylesheet %}
  .luxury-blog-section {
    max-width: 1600px;
    margin: 0 auto;
    padding: 64px 32px;
    background-color: var(--color-luxury-bg);
  }

  .luxury-blog-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px;
    margin-bottom: 48px;
  }

  @media screen and (max-width: 900px) {
    .luxury-blog-header {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 768px) {
    .luxury-blog-section {
      padding: 40px 16px;
    }
    .luxury-blog-heading {
      font-size: 2.2rem;
    }
    .luxury-blog-featured {
      min-height: 300px;
    }
    .luxury-blog-featured-content {
      padding: 24px;
      max-width: 85%;
    }
    .luxury-blog-featured-title {
      font-size: 1.8rem;
    }
    .luxury-blog-featured-bg {
      object-position: center;
    }
    .luxury-blog-featured-overlay {
      background: linear-gradient(to bottom, rgba(9,9,9,0.2) 0%, rgba(9,9,9,0.9) 100%);
    }
  }

  @media screen and (max-width: 480px) {
    .luxury-blog-featured-content {
      max-width: 100%;
      padding: 20px;
    }
    .luxury-blog-featured-title {
      font-size: 1.5rem;
    }
    .luxury-blog-card-content {
      padding: 16px;
    }
    .luxury-blog-view-all {
      display: block;
      text-align: center;
      width: 100%;
    }
    .luxury-blog-card-img {
      aspect-ratio: 16/10;
    }
  }

  .luxury-blog-kicker {
    font-family: var(--font-body--family);
    color: var(--color-luxury-accent);
    font-size: 14px;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }
  .luxury-blog-kicker::before {
    content: "— ";
  }

  .luxury-blog-heading {
    font-family: var(--font-heading--family);
    font-size: 3rem;
    line-height: 1.1;
    color: #fff;
    margin-bottom: 16px;
  }

  .luxury-blog-subtext {
    color: var(--color-luxury-text-secondary);
    font-size: 16px;
    line-height: 1.5;
    margin-bottom: 32px;
    max-width: 400px;
  }

  .luxury-blog-view-all {
    display: inline-block;
    padding: 12px 24px;
    border: 1px solid var(--color-luxury-accent) !important;
    color: var(--color-luxury-accent) !important;
    background: transparent !important;
    font-size: 13px;
    font-weight: 600;
  }
  .luxury-blog-view-all:hover {
    background: var(--color-luxury-accent) !important;
    color: #000 !important;
  }

  /* Featured Article */
  .luxury-blog-featured {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    min-height: 350px;
    display: flex;
    align-items: center;
    border: 1px solid var(--color-luxury-border);
  }

  .luxury-blog-featured-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    z-index: 0;
  }
  .luxury-blog-featured-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(to right, rgba(9,9,9,1) 0%, rgba(9,9,9,0.7) 40%, transparent 100%);
  }

  .luxury-blog-featured-content {
    position: relative;
    z-index: 1;
    padding: 48px;
    max-width: 60%;
  }

  .luxury-blog-featured-kicker {
    color: var(--color-luxury-accent);
    font-size: 12px;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }

  .luxury-blog-featured-title {
    font-family: var(--font-heading--family);
    font-size: 2.5rem;
    color: #fff;
    margin: 0 0 16px 0;
    line-height: 1.1;
  }

  .luxury-blog-featured-desc {
    color: #bbb;
    font-size: 15px;
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .luxury-blog-read-more {
    color: var(--color-luxury-accent);
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--color-luxury-accent);
    padding-bottom: 4px;
  }
  .luxury-blog-read-more:hover {
    color: #fff;
    border-color: #fff;
  }

  /* Latest Articles Header */
  .luxury-blog-latest-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--color-luxury-border);
    padding-bottom: 16px;
  }
  
  .luxury-blog-latest-kicker {
    color: var(--color-luxury-accent);
    font-size: 13px;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .luxury-blog-nav-btn {
    background: transparent;
    border: 1px solid var(--color-luxury-border);
    color: #fff;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 16px;
  }
  .luxury-blog-nav-btn:hover {
    border-color: var(--color-luxury-accent);
    color: var(--color-luxury-accent);
  }

  /* Grid */
  .luxury-blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 992px) {
    .luxury-blog-featured-content {
      padding: 32px;
      max-width: 80%;
    }
  }

  @media screen and (max-width: 600px) {
    .luxury-blog-grid {
      grid-template-columns: 1fr;
    }
    .luxury-blog-featured-content {
      padding: 24px 20px;
      max-width: 100%;
      text-align: center;
    }
    .luxury-blog-featured {
      min-height: 420px;
    }
    .luxury-blog-featured-title {
      font-size: 1.6rem;
    }
    .luxury-blog-latest-header {
      flex-direction: column;
      gap: 16px;
      align-items: flex-start;
    }
  }

  @media screen and (max-width: 420px) {
    .luxury-blog-featured-title {
      font-size: 1.4rem;
    }
  }

  .luxury-blog-card {
    display: flex;
    flex-direction: column;
    background: var(--color-luxury-card);
    border: 1px solid var(--color-luxury-border);
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.3s, border-color 0.3s;
  }
  .luxury-blog-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-luxury-accent);
  }

  .luxury-blog-card-img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    object-position: center;
  }

  .luxury-blog-card-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .luxury-blog-card-category {
    color: var(--color-luxury-accent);
    font-size: 11px;
    letter-spacing: 0.1em;
    margin-bottom: 8px;
  }

  .luxury-blog-card-title {
    color: #fff;
    font-size: 1.1rem;
    margin: 0 0 24px 0;
    line-height: 1.4;
    font-family: var(--font-heading--family);
  }

  .luxury-blog-card-readtime {
    margin-top: auto;
    color: var(--color-luxury-text-secondary);
    font-size: 11px;
    letter-spacing: 0.05em;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .luxury-blog-card:hover .luxury-blog-card-readtime {
    color: var(--color-luxury-accent);
  }
{% endstylesheet %}

