{% comment %}
  Full wishlist page. Empty by default (localStorage-driven); hydrated client-side
  by assets/wishlist-page-display.js via a real /search?q=id:X OR id:Y&type=product
  request, same technique as sections/recently-viewed.liquid.
{% endcomment %}

{% liquid
  if search.performed and search.terms contains 'id:'
    assign id_parts = search.terms | remove: 'id:' | split: ' OR '
  endif
%}

<wishlist-page-display section-id="{{ section.id }}">
  <div
    id="wishlist-page-section"
    class="wishlist-page section section--{{ section.settings.section_width }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
    data-testid="wishlist-page"
  >
    <div class="wishlist-page__header">
      <p class="luxury-kicker">{{ section.settings.kicker | default: 'Saved' }}</p>
      <h1 class="wishlist-page__heading">{{ section.settings.heading | default: 'Your Wishlist' }}</h1>
    </div>

    {% if search.performed and search.results.size > 0 %}
      <ul class="wishlist-page__list list-unstyled">
        {% for id_string in id_parts %}
          {% assign int_id = id_string | times: 1 %}
          {% assign product = search.results | where: 'id', int_id | first %}
          {% if product %}
            <li class="wishlist-page__item">
              {% render 'resource-card',
                resource_type: 'product',
                resource: product,
                image_width: 600,
                image_hover: true,
                image_aspect_ratio: '4 / 5',
                product_view_context: 'wishlist'
              %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% else %}
      <div class="wishlist-page__empty">
        <p>Nothing saved yet. Tap the heart on any product to add it here.</p>
        <a
          href="{{ routes.all_products_collection_url }}"
          class="button"
        >
          Browse the Collection
        </a>
      </div>
    {% endif %}
  </div>
</wishlist-page-display>

{% stylesheet %}
  .wishlist-page {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl);
    padding-block: var(--padding-5xl);
  }

  .wishlist-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .wishlist-page__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--h1);
    margin: 0;
  }

  .wishlist-page__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap-lg);
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .wishlist-page__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .wishlist-page__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-lg);
    color: var(--color-foreground-subdued);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wishlist Page",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Saved"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Wishlist"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Wishlist Page"
    }
  ]
}
{% endschema %}
