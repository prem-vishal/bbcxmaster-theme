{% comment %}
  Luxury BDSM-Style Contact Us Section with Responsive Cinematic Hero
{% endcomment %}

<div class="contact-page-wrapper">
  <!-- Preload hero image for performance -->
  <link rel="preload" as="image" href="{{ 'hero_master_premium_800.jpg' | asset_url }}" imagesrcset="{{ 'hero_master_premium_800.jpg' | asset_url }} 800w, {{ 'hero_master_premium.jpg' | asset_url }} 1920w" imagesizes="(max-width: 768px) 100vw, 1280px">

  <!-- HERO SECTION -->
  <section class="contact-hero" aria-label="Contact Us Hero">
    <div class="contact-hero__media">
      <picture>
        <source media="(max-width: 768px)" srcset="{{ 'hero_master_premium_800.jpg' | asset_url }} 800w">
        <source media="(min-width: 769px)" srcset="{{ 'hero_master_premium.jpg' | asset_url }} 1920w">
        <img
          src="{{ 'hero_master_premium.jpg' | asset_url }}"
          alt="BBCxMaster Customer Concierge & Support"
          class="contact-hero__img"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        >
      </picture>
      <div class="contact-hero__overlay" aria-hidden="true"></div>
    </div>

    <div class="contact-hero__container page-width">
      <div class="contact-hero__content">
        <span class="contact-hero__eyebrow">CONTACT US</span>
        <h1 class="contact-hero__title">Get in touch</h1>
        <p class="contact-hero__subtitle">We're here to help. Reach out whenever you need assistance.</p>
        
        <div class="contact-hero__badges">
          <div class="contact-hero__badge">
            <svg class="contact-hero__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>100% Private & Discrete</span>
          </div>
          <div class="contact-hero__badge">
            <svg class="contact-hero__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>24h Response Time</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN CONTACT & SUPPORT SECTION -->
  <section class="contact-body page-width">
    <div class="contact-grid">
      <!-- Left Column: Support Channels & Concierge Info -->
      <div class="contact-info">
        <div class="contact-info__header">
          <h2 class="contact-info__heading">Direct Concierge Support</h2>
          <p class="contact-info__sub">Have questions regarding your order, customized products, or discreet delivery? Contact our dedicated support team.</p>
        </div>

        <div class="contact-channel-list">
          <!-- Email Support -->
          <div class="contact-channel-card">
            <div class="contact-channel-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="contact-channel-card__body">
              <span class="contact-channel-card__label">Email Concierge</span>
              <a href="mailto:support@bbcxmaster.com" class="contact-channel-card__value">support@bbcxmaster.com</a>
              <span class="contact-channel-card__hint">Typical response within 12–24 hours</span>
            </div>
          </div>

          <!-- Live Chat / Support Hours -->
          <div class="contact-channel-card">
            <div class="contact-channel-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <div class="contact-channel-card__body">
              <span class="contact-channel-card__label">Live Chat & Support Hours</span>
              <span class="contact-channel-card__value">Mon – Fri: 9:00 AM – 6:00 PM EST</span>
              <span class="contact-channel-card__hint">Instant assistance via live chat button</span>
            </div>
          </div>

          <!-- Discreet Packaging Guarantee -->
          <div class="contact-channel-card">
            <div class="contact-channel-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            </div>
            <div class="contact-channel-card__body">
              <span class="contact-channel-card__label">Discreet Shipping Guarantee</span>
              <span class="contact-channel-card__value">Plain Outer Packaging</span>
              <span class="contact-channel-card__hint">No brand names, logos, or product details on shipping labels</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Contact Form -->
      <div class="contact-form-container">
        <h2 class="contact-form__title">Send Us a Message</h2>
        {%- form 'contact', id: 'ContactForm-Master', class: 'luxury-contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="contact-form__alert contact-form__alert--success" tabindex="-1" autofocus>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Thank you for contacting us. Your message has been safely received and our team will get back to you shortly.</span>
            </div>
          {%- elsif form.errors -%}
            <div class="contact-form__alert contact-form__alert--error" tabindex="-1" autofocus>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
              <span>Please check your form input and try again.</span>
            </div>
          {%- endif -%}

          <div class="form-group">
            <label for="ContactForm-name" class="form-label">Full Name</label>
            <input
              type="text"
              id="ContactForm-name"
              name="contact[name]"
              class="form-input"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="Your Name"
              required
              autocomplete="name"
            >
          </div>

          <div class="form-group">
            <label for="ContactForm-email" class="form-label">Email Address <span class="required">*</span></label>
            <input
              type="email"
              id="ContactForm-email"
              name="contact[email]"
              class="form-input"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="name@domain.com"
              required
              spellcheck="false"
              autocomplete="email"
            >
          </div>

          <div class="form-group">
            <label for="ContactForm-phone" class="form-label">Phone Number (Optional)</label>
            <input
              type="tel"
              id="ContactForm-phone"
              name="contact[phone]"
              class="form-input"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="+1 (555) 000-0000"
              autocomplete="tel"
            >
          </div>

          <div class="form-group">
            <label for="ContactForm-body" class="form-label">Message <span class="required">*</span></label>
            <textarea
              id="ContactForm-body"
              name="contact[body]"
              rows="5"
              class="form-input form-textarea"
              placeholder="How can we assist you today?"
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <button type="submit" class="button contact-form__submit">
            Send Message &nbsp; →
          </button>
        {%- endform -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Contact Hero & Support",
  "class": "contact-hero-section",
  "settings": []
}
{% endschema %}