<section class="popular-categories">
  <div class="page-width">
    <h2 class="popular-categories__title">POPULAR CATEGORIES</h2>
    <div class="popular-categories__grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <a href="{{ block.settings.link | default: '/collections/all' }}" class="popular-categories__item" {{ block.shopify_attributes }}>
            <div class="popular-categories__image-wrapper">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 240 }}" alt="{{ block.settings.title }}" class="popular-categories__image" loading="lazy">
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'popular-categories__image placeholder-svg' }}
              {% endif %}
            </div>
            <span class="popular-categories__label">{{ block.settings.title }}</span>
          </a>
        {% endfor %}
      {% else %}
        <a href="/collections/chastity" class="popular-categories__item">
          <div class="popular-categories__image-wrapper">
            <img
              src="{{ 'cat_chastity_1785888935375_240.jpg' | asset_url }}"
              srcset="{{ 'cat_chastity_1785888935375_240.jpg' | asset_url }} 240w, {{ 'cat_chastity_1785888935375.jpg' | asset_url }} 1024w"
              sizes="120px"
              alt="Chastity" class="popular-categories__image" loading="lazy" width="240" height="240">
          </div>
          <span class="popular-categories__label">CHASTITY</span>
        </a>
        <a href="/collections/bondage" class="popular-categories__item">
          <div class="popular-categories__image-wrapper">
            <img
              src="{{ 'cat_bondage_1785888945809_240.jpg' | asset_url }}"
              srcset="{{ 'cat_bondage_1785888945809_240.jpg' | asset_url }} 240w, {{ 'cat_bondage_1785888945809.jpg' | asset_url }} 1024w"
              sizes="120px"
              alt="Bondage" class="popular-categories__image" loading="lazy" width="240" height="240">
          </div>
          <span class="popular-categories__label">BONDAGE</span>
        </a>
        <a href="/collections/gags" class="popular-categories__item">
          <div class="popular-categories__image-wrapper">
            <img
              src="{{ 'cat_gags_1785888857681_240.jpg' | asset_url }}"
              srcset="{{ 'cat_gags_1785888857681_240.jpg' | asset_url }} 240w, {{ 'cat_gags_1785888857681.jpg' | asset_url }} 1024w"
              sizes="120px"
              alt="Gags" class="popular-categories__image" loading="lazy" width="240" height="240">
          </div>
          <span class="popular-categories__label">GAGS</span>
        </a>
        <a href="/collections/cuffs" class="popular-categories__item">
          <div class="popular-categories__image-wrapper">
            <img
              src="{{ 'cat_cuffs_1785888870033_240.jpg' | asset_url }}"
              srcset="{{ 'cat_cuffs_1785888870033_240.jpg' | asset_url }} 240w, {{ 'cat_cuffs_1785888870033.jpg' | asset_url }} 1024w"
              sizes="120px"
              alt="Cuffs" class="popular-categories__image" loading="lazy" width="240" height="240">
          </div>
          <span class="popular-categories__label">CUFFS</span>
        </a>
        <a href="/collections/lubricants" class="popular-categories__item">
          <div class="popular-categories__image-wrapper">
            <img
              src="{{ 'cat_lubricants_1785888879975_240.jpg' | asset_url }}"
              srcset="{{ 'cat_lubricants_1785888879975_240.jpg' | asset_url }} 240w, {{ 'cat_lubricants_1785888879975.jpg' | asset_url }} 1024w"
              sizes="120px"
              alt="Lubricants" class="popular-categories__image" loading="lazy" width="240" height="240">
          </div>
          <span class="popular-categories__label">LUBRICANTS</span>
        </a>
        <a href="/collections/accessories" class="popular-categories__item">
          <div class="popular-categories__image-wrapper">
            <img
              src="{{ 'cat_accessories_1785888906858_240.jpg' | asset_url }}"
              srcset="{{ 'cat_accessories_1785888906858_240.jpg' | asset_url }} 240w, {{ 'cat_accessories_1785888906858.jpg' | asset_url }} 1024w"
              sizes="120px"
              alt="Accessories" class="popular-categories__image" loading="lazy" width="240" height="240">
          </div>
          <span class="popular-categories__label">ACCESSORIES</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .popular-categories {
    background-color: var(--color-luxury-bg);
    padding: 60px 0;
  }
  .popular-categories__title {
    font-family: var(--font-body--family);
    font-size: 16px;
    letter-spacing: 0.15em;
    color: #fff;
    margin-bottom: 40px;
    text-transform: uppercase;
  }
  .popular-categories__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px;
  }
  .popular-categories__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    min-width: 0;
    cursor: pointer;
  }
  .popular-categories__image-wrapper {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px solid rgba(158, 47, 69, 0.3); /* Burgundy thin border */
    border: 2px solid color-mix(in srgb, var(--color-luxury-accent) 30%, transparent); /* Rose thin border */
    padding: 5px;
    transition: all 0.3s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
  .popular-categories__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    transition: transform 0.5s ease;
  }
  .placeholder-svg {
    background-color: #222;
    fill: #555;
  }
  .popular-categories__label {
    font-family: var(--font-body--family);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #fff;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }
  .popular-categories__item:hover .popular-categories__image-wrapper {
    border-color: var(--color-luxury-accent);
    box-shadow: 0 0 15px rgba(158, 47, 69, 0.4);
    box-shadow: 0 0 15px color-mix(in srgb, var(--color-luxury-accent) 40%, transparent);
  }
  .popular-categories__item:hover .popular-categories__image {
    transform: scale(1.1);
  }
  .popular-categories__item:hover .popular-categories__label {
    color: var(--color-luxury-accent);
  }
  
  @media screen and (max-width: 768px) {
    .popular-categories__image-wrapper {
      width: 90px;
      height: 90px;
    }
    .popular-categories__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
  }

  @media screen and (max-width: 480px) {
    .popular-categories__image-wrapper {
      width: 80px;
      height: 80px;
    }
    .popular-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .popular-categories__label {
      font-size: 10px;
      text-align: center;
      line-height: 1.3;
    }
  }
{% endstylesheet %}

