{% comment %}
  BBCxMaster — Shipping Policy Page
  Luxury private-commerce editorial design.
  Matches Privacy Policy / About Us visual identity.
  All policy content is real HTML (SEO-friendly, selectable, accessible).
{% endcomment %}

{{ 'luxury-theme.css' | asset_url | stylesheet_tag }}

<!-- Schema.org FAQ structured data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does shipping take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Order processing takes 1 to 3 business days (Monday–Friday). Domestic US standard delivery then takes 3–5 business days; priority express 1–3 business days; international express 5–10 business days."
      }
    },
    {
      "@type": "Question",
      "name": "Will my package be discreet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. All BBCxMaster orders are shipped in 100% plain, unmarked outer boxes or opaque poly-mailers with no brand logos or product descriptions on the exterior, under a neutral sender name."
      }
    },
    {
      "@type": "Question",
      "name": "How do I track my order?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Once your order is processed and handed to the carrier, an email confirmation containing a real-time tracking link is sent automatically. Allow up to 24 hours after dispatch for courier portals to update."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if my package is delayed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Transit times are estimates provided by carriers. Weather, holidays, or customs may occasionally cause delays. Our Client Concierge team actively monitors shipments and can assist with status updates."
      }
    },
    {
      "@type": "Question",
      "name": "What if I entered the wrong address?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Contact our Client Concierge team as soon as possible at support@bbcxmaster.com. If the order has not yet shipped, we will correct the delivery address; once shipped, changes depend on the carrier."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if my package arrives damaged?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If your shipment arrives with exterior or contents damage, contact our Client Concierge support within 48 hours of delivery with photos so we can immediately resolve or replace your items."
      }
    },
    {
      "@type": "Question",
      "name": "Do you ship internationally?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, BBCxMaster offers worldwide express shipping to select destination countries (5–10 business days). Any customs duties or import taxes are the responsibility of the recipient."
      }
    }
  ]
}
</script>

