  <!-- ===================== 3. QUICK INFO CARDS ===================== -->
  <section class="ship-quick page-width" aria-label="Shipping highlights">
    <div class="ship-quick__grid">
      <div class="ship-quick__card">
        <svg class="ship-quick__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>
