{% comment %}
  BBCxMaster - Privacy Policy Page Section
  Premium dark-luxury visual identity. Preserves all existing legal content.
  Customer-facing URL: /pages/privacy-policy
{% endcomment %}

<article class="privacy-page">

  <!-- Hero Section -->
  <header class="privacy-hero">
    <div class="privacy-hero__media">
      <picture>
        <source media="(max-width: 750px)" srcset="{{ 'privacy_hero_750.webp' | asset_url }}" type="image/webp">
        <source media="(max-width: 750px)" srcset="{{ 'privacy_hero_750.jpg' | asset_url }}" type="image/jpeg">
        <source media="(max-width: 1440px)" srcset="{{ 'privacy_hero_1440.webp' | asset_url }}" type="image/webp">
        <source media="(max-width: 1440px)" srcset="{{ 'privacy_hero_1440.jpg' | asset_url }}" type="image/jpeg">
        <img
          src="{{ 'privacy_hero_1920.webp' | asset_url }}"
          alt="BBCxMaster — Private vault, secure and confidential discretion"
          class="privacy-hero__img"
          loading="eager"
          width="1920"
          height="1080"
        >
      </picture>
      <div class="privacy-hero__overlay"></div>
    </div>

    <div class="privacy-hero__content">
      <nav class="luxury-breadcrumbs" aria-label="Breadcrumb navigation">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item"><a href="{{ shop.url }}">Home</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li class="breadcrumb-item active" aria-current="page">Privacy Policy</li>
        </ol>
      </nav>

      <span class="privacy-hero__kicker">PRIVACY &amp; TRUST</span>
      <h1 class="privacy-hero__title">Privacy Policy</h1>
      <p class="privacy-hero__subtitle">
        Your privacy matters. We are committed to handling your information responsibly while
        providing a discreet and secure experience.
      </p>

      <div class="privacy-last-updated">
        <span class="privacy-last-updated__icon" aria-hidden="true"></span>
        <span>Last updated: <time datetime="2026-09">September 2026</time></span>
      </div>
    </div>
  </header>

  <!-- Trust Cards -->
  <section class="privacy-trust-cards" aria-label="Trust pillars">
    <div class="trust-cards__inner">
      <div class="trust-card">
        <span class="trust-card__num" aria-hidden="true">01</span>
        <span class="trust-card__label">PRIVACY</span>
      </div>
      <div class="trust-card">
        <span class="trust-card__num" aria-hidden="true">02</span>
        <span class="trust-card__label">DISCRETION</span>
      </div>
      <div class="trust-card">
        <span class="trust-card__num" aria-hidden="true">03</span>
        <span class="trust-card__label">RESPONSIBLE DATA HANDLING</span>
      </div>
    </div>
  </section>

  <!-- Introduction -->
  <section class="privacy-intro-wrapper">
    <div class="privacy-intro">
      <p class="privacy-intro__text">
        At BBCxMaster, we recognize that discretion, personal privacy, and data security are fundamental
        expectations of our clientele. This Privacy Policy outlines the principles and protocols governing
        how we collect, use, safeguard, and manage your information when you visit our website, communicate
        with our Client Concierge, or purchase our products.
      </p>
      <p class="privacy-intro__text">
        We are committed to maintaining transparent practices that respect your privacy at every point of
        contact—from initial site browsing to discreet, unmarked home delivery.
      </p>
    </div>
  </section>

  <!-- Mobile Policy Navigation (Accordion) -->
  <nav class="privacy-mobile-nav" aria-label="Policy navigation">
    <div class="privacy-mobile-nav__container">
      <button
        type="button"
        class="privacy-mobile-nav__toggle"
        aria-expanded="false"
        aria-controls="privacy-mobile-nav-list"
        data-mobile-nav-toggle
      >
        <span class="privacy-mobile-nav__label">On this page</span>
        <span class="privacy-mobile-nav__icon" aria-hidden="true"></span>
      </button>
      <ul id="privacy-mobile-nav-list" class="privacy-mobile-nav__list" hidden>
        <li><a href="#information-we-collect">Information We Collect</a></li>
        <li><a href="#how-we-use-information">How We Use Information</a></li>
        <li><a href="#cookies">Cookies &amp; Similar Technologies</a></li>
        <li><a href="#how-we-disclose-information">Data Sharing &amp; Disclosure</a></li>
        <li><a href="#payment">Payment &amp; Transaction Information</a></li>
        <li><a href="#security-retention">Data Security &amp; Retention</a></li>
        <li><a href="#your-rights">Your Privacy Rights</a></li>
        <li><a href="#third-party-websites">Third-Party Services</a></li>
        <li><a href="#international-transfers">International Data Transfers</a></li>
        <li><a href="#childrens-data">Children's Privacy</a></li>
        <li><a href="#changes">Changes to This Privacy Policy</a></li>
        <li><a href="#contact">Contact Us</a></li>
      </ul>
    </div>
  </nav>

  <!-- Desktop Two-Column Layout -->
  <div class="privacy-main-wrapper">
    <!-- Desktop Sticky Table of Contents -->
    <aside class="privacy-toc-sidebar" aria-label="Table of Contents">
      <nav aria-label="On this page">
        <div class="toc-sticky-box">
          <h2 class="toc-title">On this page</h2>
          <ul class="toc-list">
            <li><a href="#information-we-collect">Information We Collect</a></li>
            <li><a href="#how-we-use-information">How We Use Information</a></li>
            <li><a href="#cookies">Cookies &amp; Similar Technologies</a></li>
            <li><a href="#how-we-disclose-information">Data Sharing &amp; Disclosure</a></li>
            <li><a href="#payment">Payment &amp; Transaction Information</a></li>
            <li><a href="#security-retention">Data Security &amp; Retention</a></li>
            <li><a href="#your-rights">Your Privacy Rights</a></li>
            <li><a href="#third-party-websites">Third-Party Services</a></li>
            <li><a href="#international-transfers">International Data Transfers</a></li>
            <li><a href="#childrens-data">Children's Privacy</a></li>
            <li><a href="#changes">Changes to This Privacy Policy</a></li>
            <li><a href="#contact">Contact Us</a></li>
          </ul>
        </div>
      </nav>
    </aside>

    <!-- Main Legal Content Body -->
    <div class="privacy-content-body">

      <!-- Section: Information We Collect -->
      <section id="information-we-collect" class="policy-section">
        <div class="policy-section__number">01</div>
        <h2 class="policy-section__title">Information We Collect</h2>
        <div class="policy-card">
          <p>To provide a seamless, secure shopping experience, we may collect the following types of information when you interact with our platform:</p>

          <h3 class="policy-subsection__title">A. Personal Information You Provide</h3>
          <ul class="styled-list">
            <li><strong>Contact Details:</strong> Your name, email address, telephone number, and delivery address provided during checkout or account registration.</li>
            <li><strong>Order &amp; Transaction Records:</strong> Details regarding products purchased, shipping selection, order notes, and billing history.</li>
            <li><strong>Communication Data:</strong> Inquiries, feedback, or support requests submitted via our Client Concierge, contact forms, or email.</li>
          </ul>

          <h3 class="policy-subsection__title">B. Automatically Collected Information</h3>
          <ul class="styled-list">
            <li><strong>Device &amp; Browsing Data:</strong> IP address, browser type, operating system, referring URL, pages viewed, and session duration.</li>
            <li><strong>Interaction Log:</strong> Technical metadata necessary to maintain session integrity, shopping cart items, and security monitoring.</li>
          </ul>
        </div>
      </section>

      <!-- Section: How We Use Information -->
      <section id="how-we-use-information" class="policy-section">
        <div class="policy-section__number">02</div>
        <h2 class="policy-section__title">How We Use Information</h2>
        <div class="policy-card">
          <p>We utilize your data strictly to facilitate order fulfillment, enhance site functionality, and deliver responsive client care. Uses include:</p>
          <ul class="styled-list">
            <li>Processing, verifying, and dispatching your orders with unmarked, discreet packaging.</li>
            <li>Sending essential order confirmations, shipping updates, and tracking numbers.</li>
            <li>Responding to support requests, sizing inquiries, and client feedback.</li>
            <li>Protecting our website against security threats, fraudulent transactions, and unauthorized access.</li>
            <li>Complying with applicable legal obligations, tax laws, and accounting requirements.</li>
          </ul>
        </div>
      </section>

      <!-- Section: Cookies & Similar Technologies -->
      <section id="cookies" class="policy-section">
        <div class="policy-section__number">03</div>
        <h2 class="policy-section__title">Cookies &amp; Similar Technologies</h2>
        <div class="policy-card">
          <p>Our website utilizes cookies and similar tracking technologies to ensure core functionality and provide a smooth user experience:</p>
          <ul class="styled-list">
            <li><strong>Essential Cookies:</strong> Required for fundamental site operations, such as shopping cart persistence and secure checkout navigation.</li>
            <li><strong>Performance &amp; Analytics Cookies:</strong> Allow us to measure site traffic and aggregate usage metrics to refine performance without linking data to individual identities.</li>
            <li><strong>Preference Cookies:</strong> Remember your choices (such as currency or regional settings) for future visits.</li>
          </ul>
          <p>You can manage or disable non-essential cookies through your web browser settings at any time.</p>
        </div>
      </section>

      <!-- Section: Data Sharing & Disclosure -->
      <section id="how-we-disclose-information" class="policy-section">
        <div class="policy-section__number">04</div>
        <h2 class="policy-section__title">How We Disclose Information</h2>
        <div class="policy-card">
          <p><strong>We do not sell, rent, or trade your personal information to third parties.</strong> Data is shared only with trusted operational service providers strictly necessary to execute your order:</p>
          <ul class="styled-list">
            <li><strong>Fulfillment &amp; Logistics Partners:</strong> Shipping carriers receive delivery addresses solely to transport your package.</li>
            <li><strong>Payment Processors:</strong> Encrypted financial service providers verify and complete transaction billing.</li>
            <li><strong>Legal &amp; Compliance Requirements:</strong> Data may be disclosed if required by law, court order, or formal regulatory process.</li>
          </ul>
        </div>
      </section>

      <!-- Section: Payment & Transaction Information -->
      <section id="payment" class="policy-section">
        <div class="policy-section__number">05</div>
        <h2 class="policy-section__title">Payment &amp; Transaction Information</h2>
        <div class="policy-card">
          <p>Your payment security and billing privacy are held to high standards:</p>
          <ul class="styled-list">
            <li><strong>Encrypted Checkout:</strong> All checkout data is transmitted using modern SSL/TLS encryption. We do not store raw credit card numbers on our local servers.</li>
            <li><strong>Discreet Billing Descriptors:</strong> Bank and credit card statements reflect neutral corporate descriptors without explicit product names or terminology.</li>
          </ul>
        </div>
      </section>

      <!-- Section: Data Security & Retention -->
      <section id="security-retention" class="policy-section">
        <div class="policy-section__number">06</div>
        <h2 class="policy-section__title">Data Security &amp; Retention</h2>
        <div class="policy-card">
          <p>We maintain physical, technical, and administrative safeguards designed to protect personal data against unauthorized access, loss, alteration, or misuse.</p>
          <p>Personal data is retained only for as long as necessary to fulfill the purposes outlined in this policy, satisfy legal and financial recordkeeping requirements, and resolve potential disputes.</p>
        </div>
      </section>

      <!-- Section: Your Privacy Rights -->
      <section id="your-rights" class="policy-section">
        <div class="policy-section__number">07</div>
        <h2 class="policy-section__title">Your Privacy Rights</h2>
        <div class="policy-card">
          <p>Depending on your jurisdiction, you may have rights regarding your personal information, including:</p>
          <ul class="styled-list">
            <li><strong>Access &amp; Inspection:</strong> Request a copy of the personal data held about you.</li>
            <li><strong>Correction &amp; Rectification:</strong> Request correction of incomplete or inaccurate records.</li>
            <li><strong>Deletion &amp; Erasure:</strong> Request the deletion of your personal data, subject to legal and regulatory retention duties.</li>
            <li><strong>Opt-Out:</strong> Unsubscribe from marketing communications at any time via the link in emails or by contacting Client Support.</li>
          </ul>
        </div>
      </section>

      <!-- Section: Third-Party Services -->
      <section id="third-party-websites" class="policy-section">
        <div class="policy-section__number">08</div>
        <h2 class="policy-section__title">Third-Party Websites &amp; Links</h2>
        <div class="policy-card">
          <p>Our website may contain links to third-party services or integrate external plugins for analytics or payment processing. These external entities operate under their own independent privacy policies. We encourage you to review their terms when navigating outside BBCxMaster.</p>
        </div>
      </section>

      <!-- Section: International Data Transfers -->
      <section id="international-transfers" class="policy-section">
        <div class="policy-section__number">09</div>
        <h2 class="policy-section__title">International Transfers</h2>
        <div class="policy-card">
          <p>For international clients, information collected may be processed across secure servers located in different regions. Cross-border transfers are managed in accordance with applicable data protection laws and standard security protocols.</p>
        </div>
      </section>

      <!-- Section: Children's Privacy -->
      <section id="childrens-data" class="policy-section">
        <div class="policy-section__number">10</div>
        <h2 class="policy-section__title">Children's Data</h2>
        <div class="policy-card">
          <p>BBCxMaster products and services are intended exclusively for adult consumers aged 18 and older (or the legal age of majority in your jurisdiction). We do not knowingly collect or solicit personal information from individuals under the legal age.</p>
        </div>
      </section>

      <!-- Section: Changes to This Privacy Policy -->
      <section id="changes" class="policy-section">
        <div class="policy-section__number">11</div>
        <h2 class="policy-section__title">Changes to This Privacy Policy</h2>
        <div class="policy-card">
          <p>We may update this Privacy Policy periodically to reflect changes in legal requirements or operational practices. The latest version will always be published here along with its effective date.</p>
        </div>
      </section>

      <!-- Section: Contact -->
      <section id="contact" class="policy-section">
        <div class="policy-section__number">12</div>
        <h2 class="policy-section__title">Contact Us</h2>
        <div class="policy-card privacy-contact-card">
          <p>If you have questions regarding this Privacy Policy, wish to exercise your data rights, or require guidance regarding order discretion, please reach out to our Client Concierge:</p>
          <div class="privacy-contact-details">
            <p><strong>BBCxMaster Client Concierge</strong></p>
            <p>Email: <a href="mailto:support@bbcxmaster.com" class="privacy-link">support@bbcxmaster.com</a></p>
            <p>Online Support: <a href="/pages/contact" class="privacy-link">Contact Form</a></p>
          </div>
        </div>
      </section>

    </div>
  </div>
</article>

<script>
  (function () {
    var toggle = document.querySelector('[data-mobile-nav-toggle]');
    var list = document.getElementById('privacy-mobile-nav-list');
    if (!toggle || !list) return;

    toggle.addEventListener('click', function () {
      var expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', String(!expanded));
      list.hidden = expanded;
    });
  })();
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy | BBCxMaster",
  "url": "{{ shop.url }}/pages/privacy-policy",
  "description": "Read the BBCxMaster Privacy Policy to learn how information is collected, used, protected, stored, and managed with discretion.",
  "publisher": {
    "@type": "Organization",
    "name": "BBCxMaster",
    "url": "{{ shop.url }}"
  }
}
</script>

<style>
/* ==================================================================
   BBCxMaster — Privacy Policy Premium Dark Luxury Editorial Theme
   Scoped to .privacy-page to avoid affecting other pages.
   ================================================================== */

.privacy-page {
  background-color: var(--color-luxury-bg, #090909);
  color: var(--color-luxury-text, #ffffff);
  font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
  padding-bottom: 80px;
}

/* ------------------------------------------------------------------ */
/* Hero                                                                  */
/* ------------------------------------------------------------------ */

.privacy-hero {
  position: relative;
  min-height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  border-bottom: 1px solid var(--luxury-hairline, rgba(255, 255, 255, 0.08));
}

.privacy-hero__media {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.privacy-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  display: block;
}

.privacy-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(9, 9, 9, 0.45) 0%,
    rgba(9, 9, 9, 0.85) 55%,
    rgba(9, 9, 9, 0.96) 100%
  );
}

.privacy-hero__content {
  position: relative;
  z-index: 2;
  max-width: 720px;
  padding: 70px 24px;
}

.privacy-hero__kicker {
  display: inline-block;
  font-family: var(--font-body--family);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-luxury-text-secondary, #a1a1aa);
  margin-bottom: 16px;
}

.privacy-hero__title {
  font-family: var(--font-heading--family, "Playfair Display", serif);
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  font-weight: 400;
  color: #ffffff;
  margin: 0 0 16px 0;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.privacy-hero__subtitle {
  font-size: 1.1rem;
  color: var(--color-luxury-text-secondary, #a1a1aa);
  line-height: 1.6;
  margin: 0 auto 24px;
  max-width: 600px;
}

.privacy-last-updated {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--color-luxury-text-secondary, #a1a1aa);
}

.privacy-last-updated__icon {
  display: inline-block;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--color-luxury-text-secondary, #a1a1aa);
}

/* ------------------------------------------------------------------ */
/* Breadcrumbs                                                            */
/* ------------------------------------------------------------------ */

.luxury-breadcrumbs {
  margin-bottom: 24px;
}

.breadcrumb-list {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: 0.8rem;
  color: var(--color-luxury-text-secondary, #a1a1aa);
}

.breadcrumb-separator {
  opacity: 0.4;
}

.breadcrumb-item a {
  color: var(--color-luxury-text-secondary, #a1a1aa);
  text-decoration: none;
  transition: color 0.2s ease;
}

.breadcrumb-item a:hover {
  color: var(--color-luxury-accent, #9E2F45);
}

/* ------------------------------------------------------------------ */
/* Trust Cards                                                          */
/* ------------------------------------------------------------------ */

.privacy-trust-cards {
  margin: 40px auto 0;
  max-width: 1280px;
  padding: 0 24px;
}

.trust-cards__inner {
  display: flex;
  justify-content: center;
  gap: 24px;
  flex-wrap: wrap;
}

.trust-card {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 0.85rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-luxury-text-secondary, #a1a1aa);
}

.trust-card__num {
  font-family: var(--font-heading--family, serif);
  font-size: 1.1rem;
  font-weight: 400;
  color: var(--color-luxury-accent, #9E2F45);
}

/* ------------------------------------------------------------------ */
/* Introduction                                                          */
/* ------------------------------------------------------------------ */

.privacy-intro-wrapper {
  margin: 40px auto 0;
  max-width: 720px;
  padding: 0 24px;
}

.privacy-intro {
  text-align: center;
}

.privacy-intro__text {
  font-size: 1rem;
  line-height: 1.7;
  color: var(--color-luxury-text-secondary, #a1a1aa);
  max-width: 640px;
  margin: 0 auto 16px auto;
}

/* ------------------------------------------------------------------ */
/* Mobile Navigation (Accordion)                                       */
/* ------------------------------------------------------------------ */

.privacy-mobile-nav {
  display: block;
  margin: 32px auto 0;
  max-width: 720px;
  padding: 0 24px;
}

@media (min-width: 993px) {
  .privacy-mobile-nav {
    display: none;
  }
}

.privacy-mobile-nav__container {
  background: var(--luxury-surface, #121212);
  border: 1px solid var(--luxury-hairline, rgba(255, 255, 255, 0.08));
  border-radius: 8px;
  overflow: hidden;
}

.privacy-mobile-nav__toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: transparent;
  border: none;
  color: #ffffff;
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  text-align: left;
}

.privacy-mobile-nav__toggle:hover {
  color: var(--color-luxury-accent, #9E2F45);
}

.privacy-mobile-nav__label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.privacy-mobile-nav__icon {
  display: inline-block;
  width: 16px;
  height: 1px;
  background: var(--color-luxury-text-secondary, #a1a1aa);
}

@media (prefers-reduced-motion: no-preference) {
  .privacy-mobile-nav__icon {
    transition: transform 0.2s ease;
  }
}

.privacy-mobile-nav__toggle[aria-expanded="true"] .privacy-mobile-nav__icon {
  transform: rotate(90deg);
}

.privacy-mobile-nav__list {
  list-style: none;
  margin: 0;
  padding: 12px 8px 8px;
  display: none;
}

.privacy-mobile-nav__list[hidden] {
  display: none;
}

.privacy-mobile-nav__list:not([hidden]) {
  display: block;
}

.privacy-mobile-nav__list li {
  margin-bottom: 6px;
}

.privacy-mobile-nav__list a {
  display: block;
  padding: 8px 16px;
  color: var(--color-luxury-text-secondary, #a1a1aa);
  text-decoration: none;
  font-size: 0.88rem;
  transition: color 0.2s ease;
}

.privacy-mobile-nav__list a:hover {
  color: var(--color-luxury-accent, #9E2F45);
}

/* ------------------------------------------------------------------ */
/* Two-Column Layout                                                    */
/* ------------------------------------------------------------------ */

.privacy-main-wrapper {
  max-width: 1280px;
  margin: 48px auto 0;
  padding: 0 24px;
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 48px;
}

@media (max-width: 992px) {
  .privacy-main-wrapper {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .privacy-toc-sidebar {
    display: none;
  }
}

/* ------------------------------------------------------------------ */
/* Desktop Sidebar Navigation                                           */
/* ------------------------------------------------------------------ */

.toc-sticky-box {
  position: sticky;
  top: 70px;
  background: var(--luxury-surface, #121212);
  border: 1px solid var(--luxury-hairline, rgba(255, 255, 255, 0.08));
  border-radius: 8px;
  padding: 24px;
}

.toc-title {
  font-family: var(--font-heading--family, serif);
  font-size: 0.95rem;
  color: #ffffff;
  margin: 0 0 20px 0;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  position: relative;
  padding-bottom: 12px;
}

.toc-title::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--color-luxury-accent, #9E2F45) 50%, transparent);
}

.toc-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.toc-list li {
  margin-bottom: 8px;
}

.toc-list a {
  display: block;
  padding: 6px 0;
  color: var(--color-luxury-text-secondary, #a1a1aa);
  text-decoration: none;
  font-size: 0.88rem;
  line-height: 1.4;
  transition: color 0.2s ease, padding-left 0.2s ease;
  border-left: 2px solid transparent;
}

.toc-list a:hover {
