.terms-mobile-nav__list {
  list-style: none;
  margin: 0;
  padding: 12px 8px 8px;
  display: none;
}

.terms-mobile-nav__list:not([hidden]) {
  display: block;
}

.terms-mobile-nav__list li {
  margin-bottom: 6px;
}

.terms-mobile-nav__list a {
  display: block;
  padding: 8px 16px;
  color: var(--color-luxury-text-secondary, #a1a1aa);
  text-decoration: none;
  font-size: 0.88rem;
  transition: color 0.2s ease;
}

.terms-mobile-nav__list a:hover {
  color: var(--color-luxury-accent, #9E2F45);
}

/* ------------------------------------------------------------------ */
/* Two-Column Layout                                                    */
