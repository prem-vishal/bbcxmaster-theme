<script>
  (function () {
    var toggle = document.querySelector('[data-mobile-nav-toggle]');
    var list = document.getElementById('terms-mobile-nav-list');
    if (!toggle || !list) return;

    toggle.addEventListener('click', function () {
      var expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', String(!expanded));
      list.hidden = expanded;
    });
  })();
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms of Service | BBCxMaster",
  "url": "{{ shop.url }}/pages/terms-of-service",
  "description": "Review the BBCxMaster Terms of Service, including eligibility, account responsibilities, acceptable use, purchases, privacy, liability, and governing terms.",
  "publisher": {
    "@type": "Organization",
    "name": "BBCxMaster",
    "url": "{{ shop.url }}"
  }
}
</script>

<style>
/* ==================================================================
   BBCxMaster — Terms of Service Premium Dark Luxury Editorial Theme
   Scoped to .terms-page to avoid affecting other pages.
   ================================================================== */

.terms-page {
  background-color: var(--color-luxury-bg, #090909);
  color: var(--color-luxury-text, #ffffff);
  font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
  padding-bottom: 80px;
}

/* ------------------------------------------------------------------ */
/* Hero                                                                  */
/* ------------------------------------------------------------------ */

.terms-hero {
  position: relative;
  min-height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  border-bottom: 1px solid var(--luxury-hairline, rgba(255, 255, 255, 0.08));
}

.terms-hero__media {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.terms-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  display: block;
}

.terms-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(9, 9, 9, 0.45) 0%,
    rgba(9, 9, 9, 0.85) 55%,
    rgba(9, 9, 9, 0.96) 100%
  );
}

.terms-hero__content {
  position: relative;
  z-index: 2;
  max-width: 720px;
  padding: 70px 24px;
}

.terms-hero__kicker {
  display: inline-block;
  font-family: var(--font-body--family);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-luxury-text-secondary, #a1a1aa);
  margin-bottom: 16px;
}

.terms-hero__title {
  font-family: var(--font-heading--family, "Playfair Display", serif);
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  font-weight: 400;
  color: #ffffff;
  margin: 0 0 16px 0;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.terms-hero__subtitle {
  font-size: 1.1rem;
  color: var(--color-luxury-text-secondary, #a1a1aa);
  line-height: 1.6;
  margin: 0 auto 24px;
  max-width: 600px;
}

.terms-last-updated {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--color-luxury-text-secondary, #a1a1aa);
}

.terms-last-updated__icon {
  display: inline-block;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--color-luxury-text-secondary, #a1a1aa);
}

/* ------------------------------------------------------------------ */
/* Breadcrumbs                                                            */
/* ------------------------------------------------------------------ */

.luxury-breadcrumbs {
  margin-bottom: 24px;
}

.breadcrumb-list {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: 0.8rem;
  color: var(--color-luxury-text-secondary, #a1a1aa);
}

.breadcrumb-separator {
  opacity: 0.4;
}

.breadcrumb-item a {
  color: var(--color-luxury-text-secondary, #a1a1aa);
  text-decoration: none;
  transition: color 0.2s ease;
}

.breadcrumb-item a:hover {
  color: var(--color-luxury-accent, #9E2F45);
}

/* ------------------------------------------------------------------ */
/* Trust Cards                                                          */
/* ------------------------------------------------------------------ */

.terms-trust-cards {
  margin: 40px auto 0;
  max-width: 1280px;
  padding: 0 24px;
}

.trust-cards__inner {
  display: flex;
  justify-content: center;
  gap: 24px;
  flex-wrap: wrap;
}

.trust-card {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 0.85rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-luxury-text-secondary, #a1a1aa);
}

.trust-card__num {
  font-family: var(--font-heading--family, serif);
  font-size: 1.1rem;
  font-weight: 400;
  color: var(--color-luxury-accent, #9E2F45);
}

/* ------------------------------------------------------------------ */
/* Introduction                                                          */
/* ------------------------------------------------------------------ */

.terms-intro-wrapper {
  margin: 40px auto 0;
  max-width: 720px;
  padding: 0 24px;
}

.terms-intro {
  text-align: center;
}

.terms-intro__text {
  font-size: 1rem;
  line-height: 1.7;
  color: var(--color-luxury-text-secondary, #a1a1aa);
  max-width: 640px;
  margin: 0 auto;
}

/* ------------------------------------------------------------------ */
/* Mobile Navigation (Accordion)                                       */
/* ------------------------------------------------------------------ */

.terms-mobile-nav {
  display: block;
  margin: 32px auto 0;
  max-width: 720px;
  padding: 0 24px;
}

@media (min-width: 993px) {
  .terms-mobile-nav {
    display: none;
  }
}

.terms-mobile-nav__container {
  background: var(--luxury-surface, #121212);
  border: 1px solid var(--luxury-hairline, rgba(255, 255, 255, 0.08));
  border-radius: 8px;
  overflow: hidden;
}

.terms-mobile-nav__toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: transparent;
  border: none;
  color: #ffffff;
  font-size: 0.95rem;
  font-weight: 500;
